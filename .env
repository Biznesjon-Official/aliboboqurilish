# React development settings
GENERATE_SOURCEMAP=false
TSC_COMPILE_ON_ERROR=true
ESLINT_NO_DEV_ERRORS=true
FAST_REFRESH=true
CHOKIDAR_USEPOLLING=false

# Disable React DevTools warnings
REACT_EDITOR=none

# Reduce webpack output
WEBPACK_HIDE_COMPILATION_WARNINGS=true

# Debug mode for OptimizedImage component
REACT_APP_DEBUG_MODE=true