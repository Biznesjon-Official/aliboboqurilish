{
  "name": "alibobo-react",
  "version": "0.1.0",
  "private": true,
  "proxy": "http://localhost:5000",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/free-brands-svg-icons": "^7.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@fortawesome/react-fontawesome": "^3.0.2",
    "@tanstack/react-query": "^5.85.3",
    "@tanstack/react-query-devtools": "^5.85.3",
    "chart.js": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.0.0",
    "react-router-dom": "^6.30.1",
    "react-scripts": "5.0.1",
    "react-virtualized-auto-sizer": "^1.0.26",
    "react-window": "^1.8.11",
    "react-window-infinite-loader": "^1.0.10",
    "socket.io-client": "^4.8.1"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --raw \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm start",
    "dev:frontend": "cross-env PORT=3000 GENERATE_SOURCEMAP=false react-scripts start",
    "start": "concurrently --kill-others-on-fail --raw \"npm run dev:backend\" \"npm run dev:frontend\"",
    "backend": "cd backend && npm start",
    "frontend": "cross-env PORT=3000 GENERATE_SOURCEMAP=false react-scripts start",
    "build": "cross-env CI=false react-scripts build",
    "build:prod": "npm run build && cd backend && npm install --production",
    "start:prod": "cd backend && NODE_ENV=production node server.js",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-unused-vars": "off",
      "react-hooks/exhaustive-deps": "off",
      "jsx-a11y/anchor-is-valid": "off",
      "jsx-a11y/img-redundant-alt": "off",
      "no-useless-escape": "off"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "http-proxy-middleware": "^3.0.5",
    "png-to-ico": "^2.1.8",
    "postcss": "^8.4.32",
    "sharp": "^0.33.4",
    "tailwindcss": "^3.3.6",
    "webpack-bundle-analyzer": "^4.10.2"
  }
}