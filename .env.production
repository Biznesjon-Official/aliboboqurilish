# Production Environment Configuration for Frontend
REACT_APP_API_BASE=https://aliboboqurilish.uz/api
REACT_APP_SOCKET_URL=https://aliboboqurilish.uz
REACT_APP_DEBUG_MODE=false
REACT_APP_ENVIRONMENT=production

# Performance settings
GENERATE_SOURCEMAP=false

# Image optimization
REACT_APP_IMAGE_QUALITY=80
REACT_APP_IMAGE_LAZY_LOADING=true

# Performance monitoring
REACT_APP_PERFORMANCE_MONITORING=true
REACT_APP_USE_FAST=true